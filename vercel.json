{
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "proof.wholefounder.com" }],
      "destination": "/wf-proof/:path*"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "proof.wholefounder.com" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    }
  ]
}
